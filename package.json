{
  "name": "olafs-reha-kompass-premium",
  "version": "1.0.0",
  "private": true,
  "description": "Geschuetzter persoenlicher Reha-Kompass mit gefuehrtem Cockpit, verschluesselter Synchronisierung, Dokumentenarchiv, Web Push und optionaler KI-Unterstuetzung",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "node server.js",
    "start:fresh": "node scripts/start-fresh-local.mjs",
    "build": "node scripts/build.mjs",
    "prepare:render-secrets": "node scripts/prepare-render-secrets.mjs",
    "prepare:render-rc-secrets": "node scripts/prepare-render-rc-secrets.mjs",
    "check": "npm run lint && npm run test:unit && npm run test:integration && npm run build",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test test/e2e/accessibility.spec.js",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "openai": "^6.9.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "axe-core": "^4.11.0",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "supertest": "^7.1.4"
  }
}
